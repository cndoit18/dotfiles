# Reusable visual classes only. Copy into a diagram-specific D2 model; this file adds no systems or relationships.
classes: {
  service: {
    style: {
      fill: "#EFF6FF"
      stroke: "#60A5FA"
      font-color: "#0F172A"
      font-size: 20
      bold: true
      border-radius: 12
    }
  }
  store: {
    style: {
      fill: "#ECFDF5"
      stroke: "#34D399"
      font-color: "#0F172A"
      font-size: 20
      bold: true
      border-radius: 12
    }
  }
  external: {
    style: {
      fill: "#F8FAFC"
      stroke: "#94A3B8"
      font-color: "#0F172A"
      font-size: 20
      bold: true
      border-radius: 12
    }
  }
  direct: {
    style: {
      stroke: "#475569"
      font-color: "#334155"
      font-size: 16
      stroke-width: 2
    }
  }
  event: {
    style: {
      stroke: "#7C3AED"
      font-color: "#6D28D9"
      font-size: 16
      stroke-width: 2
      stroke-dash: 6
    }
  }
}
